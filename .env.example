# Where FreeLLMAPI lives. Inside Coolify use the container name on the shared
# Docker network; locally use its public URL.
UPSTREAM_URL=http://freellmapi:3001

LISTEN_ADDR=:8080

# Langfuse OTLP endpoint (the exporter appends /v1/traces).
# Self-hosted on Coolify: http://<langfuse-container>:3000/api/public/otel
OTEL_EXPORTER_OTLP_ENDPOINT=https://langfuse.advaitjain.com/api/public/otel
# AUTH = base64 of "pk-lf-...:sk-lf-..."  ->  echo -n "pk:sk" | base64 -w 0
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<AUTH>,x-langfuse-ingestion-version=4
OTEL_SERVICE_NAME=llmtrace

# Send prompts/completions to Langfuse. Off by default: Claude Code traffic
# contains your source code.
CAPTURE_CONTENT=false
MAX_CAPTURE_BYTES=32768

# Ask OpenAI-style providers to report usage on streams.
INJECT_INCLUDE_USAGE=true
FORWARD_TRACEPARENT=true
LLMTRACE_ENVIRONMENT=production
